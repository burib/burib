function lowerCase() {
  tr '[:upper:]' '[:lower:]'
}

function upperCase() {
  tr '[:lower:]' '[:upper:]'
}

function sentenceCase() {
    # Read input from stdin
    while read -r line; do
        local string="$line"
        local result=""
        local word=""
        local first_char=""
        local rest_chars=""

        # Convert the first character of each word to uppercase
        for word in $string; do
            first_char="${word:0:1}"
            rest_chars="${word:1}"
            result="$result $(echo "$first_char" | tr '[:lower:]' '[:upper:]')$(echo "$rest_chars" | tr '[:upper:]' '[:lower:]')"
        done

        # Remove leading whitespace
        result="${result## }"

        echo "$result"
    done
}

titleCase() {
    # Read input from stdin
    while read -r line; do
        local string="$line"
        local result=""
        local word=""

        # Convert each word to title case
        for word in $string; do
            result="$result $(echo "${word^}")"
        done

        # Remove leading whitespace
        result="${result## }"

        echo "$result"
    done
}


