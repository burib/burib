function current_branch() {
  current_branch=$(git symbolic-ref --short HEAD)
  echo "$current_branch" | pbcopy
  echo "\033[0;33m'$current_branch' copied to clipboard.\033[0m"
}
function rebase_branch() {
  current_branch=$(git symbolic-ref --short HEAD)
  git checkout main
  git pull
  git checkout $current_branch
  git rebase main
}
function rebase_master() {
  current_branch=$(git symbolic-ref --short HEAD)
  git checkout master
  git pull
  git checkout $current_branch
  git rebase master
}
function main() {
  git checkout main
  git pull
}

