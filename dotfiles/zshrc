eval "$(oh-my-posh init zsh --config ~/.config/powerlevel10k_lean.omp.json)"


# AWS profile helpers (use / aws_who / list / aws_reset / ...) live in ~/aws_profile.sh,
# sourced further down. They used to be duplicated here as well, but since that
# source line runs last it always won -- this copy was dead code.

# Homebrew: Python
export PATH="/opt/homebrew/opt/python/libexec/bin:$PATH"

# nvm. Sourced directly (not via `brew --prefix nvm`) so that a broken or slow
# brew can't take out the whole shell: when brew errors, $(brew --prefix nvm) is
# empty and this line used to become `source /nvm.sh`. Also saves a brew
# subprocess on every shell start.
export NVM_DIR="$HOME/.nvm"
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  source "$NVM_DIR/nvm.sh"
elif [[ -s /opt/homebrew/opt/nvm/nvm.sh ]]; then
  source /opt/homebrew/opt/nvm/nvm.sh
fi

# Dev helpers (git, tofu, text utils, dark/light, ...) - single source of truth
# in the burib/burib repo, cloned by scripts/setup_mac.sh. The git/terraform
# functions and aliases that used to be defined here live there now; a
# `git pull` in that repo updates every machine.
[[ -f "$HOME/dev/burib/burib/scripts/dev_utils.sh" ]] && source "$HOME/dev/burib/burib/scripts/dev_utils.sh"

source ~/aws_profile.sh
source ~/aws_s3.sh


# Added by Antigravity
export PATH="/Users/burib/.antigravity/antigravity/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
