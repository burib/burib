function clone_all_org_repos() {
  # Check for required tools
  if ! command -v gh &> /dev/null; then
    echo "Error: GitHub CLI 'gh' not found. Please install it (https://cli.github.com/)." >&2
    return 1
  fi
  # jq IS now required because we need to parse the JSON reliably
  if ! command -v jq &> /dev/null; then
    echo "Error: 'jq' not found. Please install it (e.g., 'brew install jq' or 'sudo apt install jq')." >&2
    return 1
  fi
   if ! command -v git &> /dev/null; then
    echo "Error: 'git' not found. Please install it." >&2
    return 1
  fi

  # Check gh authentication status
   if ! gh auth status &> /dev/null; then
     echo "Error: Not logged into GitHub CLI. Please run 'gh auth login'." >&2
     return 1
   fi

  # --- Arguments ---
  local org_name="$1"
  local target_dir="${2:-./${org_name}}" # Default to ./org-repos

  if [[ -z "$org_name" ]]; then
    echo "Usage: $0 <org_name> [target_directory]" >&2
    return 1
  fi

  echo "Fetching repository list for organization: '$org_name'..."

  # --- Fetch Repo List ---
  # Use --json to get structured data and jq to extract *only* the owner/repo name
  local repo_id_list # Store the clean list of owner/repo
  if ! repo_id_list=$(gh repo list "$org_name" --limit 4000 --no-archived --json nameWithOwner | jq -r '.[].nameWithOwner'); then
      echo "Error: Failed to fetch repository list using 'gh repo list --json nameWithOwner'." >&2
      return 1
  fi

  if [[ -z "$repo_id_list" ]]; then
      echo "No repositories found for organization '$org_name' or you may lack permissions."
      return 0
  fi

  echo "Target directory: '$target_dir'"
  mkdir -p "$target_dir" # Create base target directory if it doesn't exist

  # --- Process Repositories ---
  local repo_id # Will contain OWNER/REPO
  local repo_name
  local clone_path
  local success_count=0
  local update_count=0
  local fail_count=0
  local total_count=0

  # Pipe the clean list of repo IDs into the loop
  while IFS= read -r repo_id; do
    # Check for empty lines just in case (jq shouldn't produce them, but belt-and-suspenders)
    if [[ -z "$repo_id" ]]; then continue; fi

    total_count=$((total_count + 1))
    repo_name=$(basename "$repo_id") # Extract repo name (e.g., my-repo) from OWNER/REPO
    clone_path="$target_dir/$repo_name" # Construct full path for clone/pull

    echo # Add a newline for better readability between repos
    echo "Processing '$repo_name' (from $repo_id)..."

    # Check if directory already exists and is a git repo
    if [[ -d "$clone_path/.git" ]]; then
      echo " -> Directory exists. Updating (git pull)..."
      if git -C "$clone_path" pull --rebase; then # Use rebase pull or remove --rebase for merge
        echo " -> Update successful for '$repo_name'."
        update_count=$((update_count + 1))
      else
        echo "Error: Failed to update '$repo_name'. Check for conflicts or errors above." >&2
        fail_count=$((fail_count + 1))
      fi
    elif [[ -e "$clone_path" ]]; then
      # Path exists but is not a git repository
       echo "Warning: Path '$clone_path' exists but is not a git repository. Skipping '$repo_name'." >&2
       fail_count=$((fail_count + 1))
    else
      # Directory does not exist, clone it using gh repo clone
      echo " -> Cloning '$repo_id' into '$clone_path'..."
      # Use gh repo clone: gh repo clone OWNER/REPO TARGET_DIRECTORY
      if gh repo clone "$repo_id" "$clone_path"; then
        echo " -> Clone successful for '$repo_name'."
        success_count=$((success_count + 1))
      else
        echo "Error: Failed to clone '$repo_name' using 'gh repo clone'." >&2
        fail_count=$((fail_count + 1))
      fi
    fi
  done <<< "$repo_id_list" # Feed the clean repo ID list into the loop

  # --- Summary ---
  if [[ $total_count -eq 0 ]]; then
      # This case should ideally be caught by the check after fetching, but double-check
      echo "\nNo repositories were processed for '$org_name'."
      return 0
  fi

  echo "\n----- Summary -----"
  echo "Total repositories processed: $total_count"
  echo "Successfully cloned:        $success_count"
  echo "Successfully updated:       $update_count"
  echo "Failed operations:          $fail_count"
  echo "-------------------"

  if [[ $fail_count -gt 0 ]]; then
      return 1 # Return error code if any operation failed
  fi
  return 0
}

